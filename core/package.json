{
  "name": "openspread-core",
  "version": "0.1.0",
  "private": true,
  "description": "OpenSpread core: local-first, read-only cross-exchange stablecoin spreads. A bitcoin100treta project.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:exchanges": "tsx scripts/check-exchanges.ts",
    "mcp": "node bin/openspread-mcp.mjs",
    "live:probe": "node bin/live-probe.mjs",
    "live:sim": "node bin/live-sim.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@scure/base": "2.2.0",
    "ccxt": "~4.5.92"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "ws": "8.21.0"
  },
  "overrides": {
    "undici": "7.30.2"
  }
}
